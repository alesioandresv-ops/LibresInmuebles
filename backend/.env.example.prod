# ============================================================
# LibreInmuebles — backend/.env de PRODUCCIÓN (copiar a .env)
# Stack 100% gratis: Render (backend) + Supabase (Postgres + Storage) + Vercel (frontend)
# ============================================================

# Entorno de producción
APP_ENV=prod

# Supabase Database: usar el SESSION POOLER (IPv4). El host directo
# db.<ref>.supabase.co es IPv6-only y NO es alcanzable desde Render.
# app/<region>.pooler.supabase.com / puerto 5432
DATABASE_URL=postgresql://postgres.<ref>:clave@aws-0-<region>.pooler.supabase.com:5432/postgres

# Seguridad: generar con  python -c "import secrets; print(secrets.token_urlsafe(64))"
# (mínimo 32 caracteres, obligatorio en prod)
SECRET_KEY=change-me-por-una-clave-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS: dominio del frontend publicado en Vercel
CORS_ORIGINS=https://libres-inmuebles.vercel.app

# Supabase Storage (fotos durables). Proceso una vez:
#   python -m app.scripts.setup_storage_bucket
# la service_role key se genera en Supabase -> Settings -> API keys (nunca exponerla)
SUPABASE_PROJECT_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=properties

# Storage local (solo dev/tests; en prod el filesystem es efímero)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS_SIDE=8000

# Dominio público del frontend (se usa en los links de los emails)
FRONTEND_URL=https://libres-inmuebles.vercel.app

# Emails de moderadores (comma separated) -> is_staff=true al registrarse
STAFF_EMAILS=moderador@example.com

# SMTP (vacío => los correos solo se loguean). Recomendado: Brevo/SendGrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LibreInmuebles <no-reply@libreinmuebles.com.ar>
SMTP_TLS=true

# Rate limiting de /auth: SIEMPRE activo en prod
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

LOG_LEVEL=INFO