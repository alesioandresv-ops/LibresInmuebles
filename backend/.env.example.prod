# ============================================================
# LibreInmuebles — backend/.env de PRODUCCIÓN (copiar a .env)
# Railway: crear Service "libreinmuebles-api" desde backend/
# ============================================================

# Entorno de producción
APP_ENV=prod

# Railway entrega 'postgresql://...' y la app lo traduce a postgresql+psycopg://...
# Generar DB PostgreSQL en Railway y pegar acá su DATABASE_URL
DATABASE_URL=postgresql://usuario:password@host:5432/libreinmuebles

# Seguridad: generar con  python -c "import secrets; print(secrets.token_urlsafe(64))"
# (mínimo 32 caracteres, obligatorio en prod)
SECRET_KEY=change-me-por-una-clave-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS: dominio del frontend publicado (al menos uno)
CORS_ORIGINS=https://libreinmuebles.up.railway.app

# Storage de imágenes. OJO: el filesystem de Railway es efímero;
# para persistencia real mover a objeto (S3/R2) o montar un volumen.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS_SIDE=8000

# Dominio público del frontend (se usa en los links de los emails)
FRONTEND_URL=https://libreinmuebles.up.railway.app

# Emails de moderadores (comma separated) -> is_staff=true al registrarse
STAFF_EMAILS=moderador@example.com

# SMTP (vacío => los correos solo se loguean). Recomendado: Brevo/SendGrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LibreInmuebles <no-reply@libreinmuebles.com.ar>
SMTP_TLS=true

# Rate limiting de /auth: SIEMPRE activo en prod
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

LOG_LEVEL=INFO