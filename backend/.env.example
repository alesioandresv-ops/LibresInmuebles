# Entorno: dev | prod
APP_ENV=dev

# SQLite (dev)  ->  PostgreSQL (prod) con el driver psycopg.
# En prod la app acepta 'postgresql://...' (lo que da Railway) y lo traduce a 'postgresql+psycopg://...'.
DATABASE_URL=sqlite:///./libreinmuebles.db

# Seguridad: generar con  python -c "import secrets; print(secrets.token_urlsafe(64))"
# En APP_ENV=prod la app NO arranca si SECRET_KEY es vacía, 'change-me' o < 32 caracteres.
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Storage de imágenes
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Origen público del frontend (usado en emails de la app)
FRONTEND_URL=http://localhost:5173

# Emails de moderadores (comma separated). Si el email coincide al registrarse -> is_staff=true
STAFF_EMAILS=

# SMTP: vacío => los correos se loguean en consola (dev). Configurado => envío real (ej. Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LibreInmuebles <no-reply@libreinmuebles.com.ar>
SMTP_TLS=true

# Rate limiting de /auth (fuerza bruta). Activarlo en prod.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

LOG_LEVEL=INFO